# Local runs only. In GitHub Actions these are repository secrets.
ANTHROPIC_API_KEY=
SMTP_USER=            # Gmail address
SMTP_PASS=            # Gmail App Password (not the account password)
NVD_API_KEY=          # optional, raises the NVD rate limit
# DRY_RUN=1           # write emails to out/emails instead of sending
# MOCK_LLM=1          # offline heuristic instead of Claude (tests and demos)
